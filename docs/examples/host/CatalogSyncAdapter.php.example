<?php

declare(strict_types=1);

namespace App\Omnichannel;

use Karnoweb\Omnichannel\Contracts\CatalogSyncTriggerContract;
use Karnoweb\Omnichannel\Models\Publication;

final class CatalogSyncAdapter implements CatalogSyncTriggerContract
{
    public function recordChange(Publication $publication, array $snapshot): void
    {
        app(\Karnoweb\Omnichannel\Services\CatalogSyncService::class)
            ->recordProductChange($publication, $snapshot);
    }
}